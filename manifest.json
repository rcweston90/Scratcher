{
  "manifest_version": 3,
  "name": "Scratcher",
  "version": "0.5.1",
  "description": "A plain text pad in the side panel. Paste, drop or send text to it, copy it or hear it read aloud. Saves on this device.",
  "homepage_url": "https://github.com/rcweston90/scratcher",
  "minimum_chrome_version": "116",
  "permissions": ["sidePanel", "storage", "contextMenus"],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "action": {
    "default_title": "Scratcher (⌥⇧D)",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "commands": {
    "toggle-panel": {
      "suggested_key": {
        "default": "Alt+Shift+D",
        "mac": "Alt+Shift+D"
      },
      "description": "Open or close Scratcher"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
